# ── Core —───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
APP_URL=http://localhost:8080
JWT_SECRET=change-me-in-production
SUPERADMIN_EMAIL=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=
# POSTGRES_URL=

# ── Supabase (auth + profiles + avatars storage) ────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google OAuth (legacy Express sign-in) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Chapa Payment Gateway ───────────────────────────────────────────────────
# Test keys come from https://dashboard.chapa.co (Settings > API Keys).
# Docs: https://chapa.co/developers
# Supported secret formats:
#   v2 TEST: CHAPA_TEST_PRIV_...   |  v2 LIVE: CHAPA_LIVE_PRIV_...
#   v1 TEST: CHASECK_TEST-...      |  v1 LIVE: CHASECK-...
# TEST mode: CHAPA_ENV=test
# LIVE mode: CHAPA_ENV=live
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_ENV=test
# Optional encryption key from the Chapa dashboard (v2).
# CHAPA_ENCRYPTION_KEY=
# Optional: override the payment currency (defaults to ETB).
# CHAPA_CURRENCY=ETB